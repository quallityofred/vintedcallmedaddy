TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
CHECK_INTERVAL_SECONDS=120

# Database Configuration
# Local SQLite: sqlite+aiosqlite:///./data/vinted.db
# Cloud PostgreSQL (Supabase/Neon): postgresql+asyncpg://postgres:[YOUR-PASSWORD]@[YOUR-DB-HOST]:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:password@db.example.supabase.co:5432/postgres

PROXIES=
SESSIONS_PER_DOMAIN=3
RATE_LIMIT_PER_MINUTE=8

# Cloudflare Workers fallback (optional)
CF_WORKER_URL=https://vintedbot.egorytub90.workers.dev/
CF_WORKER_BLOCK_THRESHOLD=2
CF_WORKER_RECOVERY_MINUTES=10

# Adaptive scheduling
PEAK_START_HOUR=8
PEAK_END_HOUR=23
OFFPEAK_INTERVAL_MULTIPLIER=2.5
NIGHT_INTERVAL_MULTIPLIER=5.0
