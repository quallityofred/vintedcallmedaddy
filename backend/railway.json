{
  "build": {
    "builder": "nixpacks",
    "buildCommand": "poetry install --only main --no-root"
  },
  "deploy": {
    "startCommand": "sh -c 'poetry run uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8080}'",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
